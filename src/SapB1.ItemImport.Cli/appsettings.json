{
  // Connection and behaviour defaults. Command line arguments and environment variables win over
  // anything set here. NEVER commit a real password — leave it empty and set SAPB1_PASSWORD instead.
  "ServiceLayer": {
    "BaseUrl": "https://sap-b1.example.local:50000/b1s/v1",
    "CompanyDb": "SBODEMOGB",
    "UserName": "manager",
    "Password": "",

    "TimeoutSeconds": 90,
    "MaxRetries": 3,
    "RetryBaseDelaySeconds": 2,

    // Leave false. A POST that times out may already have been committed by SAP, so retrying it can
    // create a duplicate item. Failed creates are reported and a re-run in upsert mode reconciles them.
    "RetryWritesOnTransientFailure": false,

    // Makes supplied price rows replace the stored ItemPrices collection instead of merging by position.
    "ReplaceCollectionsOnPatch": true,

    "ExistenceFilterChunkSize": 20,

    // Preferred way to accept the self-signed certificate a default on-premise Service Layer ships with.
    "ServerCertificateThumbprint": null,

    // Insecure: accepts any certificate, including an attacker's. Use the thumbprint above instead.
    "TrustAnyServerCertificate": false
  },

  "Import": {
    // upsert | create-only | update-only
    "Mode": "upsert",
    "DryRun": false,
    "MaxErrors": 0,
    "ExistenceProbeBatchSize": 50,
    "AllowDuplicateItemCodes": false,
    "ReportPath": null,
    "FailuresOnly": false
  },

  "Csv": {
    // null auto-detects from the header row.
    "Delimiter": null,
    "Encoding": "utf-8",
    // Empty or "invariant" parses 1234.56; use "de-DE" for 1.234,56.
    "Culture": "",
    "TrimValues": true
  },

  "Mapping": {
    // ignore | warn | error
    "UnknownColumns": "warn",
    "DefaultPriceList": 1,
    "NullToken": "<NULL>",
    "ItemCodePattern": null,

    // Source column -> SAP property, for headers the built-in catalog cannot resolve.
    // Map a column to null to drop it deliberately.
    "Columns": {}
  }
}
